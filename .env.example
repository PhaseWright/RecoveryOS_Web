# Copy to .env.local for Vite. Do not commit real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA v3 site key from Firebase App Check (same value is fine in the client bundle).
# VITE_FIREBASE_APPCHECK_SITE_KEY=

# Show the social footer block on production builds (hidden by default).
# Dev (`npm run dev`) always shows it for layout checks.
# VITE_SHOW_SOCIAL=true
