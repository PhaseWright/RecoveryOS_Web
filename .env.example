# Copy to .env.local for Vite. Do not commit real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: reCAPTCHA v3 site key from Firebase App Check (same value is fine in the client bundle).
# VITE_FIREBASE_APPCHECK_SITE_KEY=

# The social footer block (real Facebook/Instagram/Bluesky/X/LinkedIn/Threads links) shows
# by default now that those accounts are live. Set to "false" to hide it if ever needed.
# VITE_SHOW_SOCIAL=false

# Public app store listing URLs. Leave unset to keep "Coming soon" badges (no pixel events).
# VITE_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=org.recoveryos.app
# VITE_APP_STORE_URL=https://apps.apple.com/app/recoveryos/id0000000000
