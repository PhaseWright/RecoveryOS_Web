rules_version = '2';

// We restrict the marketing site's Firestore writes to the waitlist collection
// only, with strict shape + size validation. The Firebase Web API key is public
// by design; security relies on these rules and (later) App Check.
service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlist_signups/{entryId} {
      allow read, update, delete: if false;

      allow create: if
        request.resource.data.keys().hasOnly(['email', 'createdAt', 'source', 'page', 'legacyId'])
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.source == 'recoveryos-web-landing'
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 32
        && request.resource.data.legacyId is string
        && request.resource.data.legacyId.size() > 0
        && request.resource.data.legacyId.size() <= 280
        && request.resource.data.createdAt == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
